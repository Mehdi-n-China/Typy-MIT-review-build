"""Python's ``while`` loop."""

from .. import tools
from ..tree import place
from ._bridge import parse_python_expression
from ._body import parse_body, require_header_colon
from ._else_clause import parse_else_clause
from ._errors import syntax_error
from ..lexer import LogicalLine
from ._context import ParseContext


tuple parse_while(ParseContext ctx, list lines, int index, list decorators):
    """Parse ``while test:`` (with an optional ``else:``)."""
    LogicalLine line = lines[index]
    int colon = require_header_colon(ctx, line, "while")

    if colon == 1:
        raise syntax_error(ctx, "'while' needs a condition", line.first)

    dyn test = parse_python_expression(ctx, line.tokens[1:colon])
    list body = parse_body(ctx, line, colon, "'while'")

    dyn orelse = None
    orelse, index = parse_else_clause(ctx, lines, index + 1)

    # Build the Python AST node with the parsed condition and clauses.
    tools.pyast.While node = tools.pyast.While(test=test, body=body, orelse=orelse)

    return [place(node, line.first, line.tokens[colon])], index