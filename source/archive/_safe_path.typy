"""Refusing archive paths that would escape the destination ("zip slip")."""

from .. import tools
from ..errors import TypyArchiveError


tools.path.Path safe_destination(
    tools.path.Path destination,
    str relative,
    ):
    """The absolute path for archive member ``relative`` under ``destination``.

    Absolute paths, drive letters, backslashes and any ``..`` component are
    rejected, and the final path is re-checked to still sit inside
    ``destination`` after symlinks are resolved.
    """

    tools.path.PurePosixPath pure = tools.path.PurePosixPath(relative)
    dyn first = pure.parts[0] if pure.parts else ""

    # Reject paths with unsafe or platform-specific components.
    if (
        not pure.parts
        or pure.is_absolute()
        or ".." in pure.parts
        or "\\" in relative
        or ":" in first
    ):
        raise TypyArchiveError(
            f"unsafe path in archive: {relative!r}"
        )

    # Resolve symlinks and verify the final path remains inside the destination.
    tools.path.Path target = (destination / pure).resolve()

    if destination.resolve() not in target.parents:
        raise TypyArchiveError(
            f"archive path escapes the destination: {relative!r}"
        )

    return target
