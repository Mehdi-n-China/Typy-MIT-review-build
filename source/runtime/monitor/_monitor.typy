"""The monitor itself."""

import sys
import time


str _name_of(str kind):
    return "established" if kind is None else kind.__name__


class EnforcementMonitor:
    """Counts and prints every enforcement event it is handed."""

    void __init__(EnforcementMonitor self, str entry_point, dyn stream = None):
        self.entry_point = entry_point
        self.stream = stream or sys.stderr
        self.total = self.passed = self.failed = 0
        self.by_name = {}
        self.started = time.time()

    void _line(EnforcementMonitor self, str text):
        print(text, file=self.stream)

    void start(EnforcementMonitor self):
        self.started = time.time()
        self._line(f"=== Typy enforcement monitor -- entry point: {self.entry_point} ===")

    void __call__(EnforcementMonitor self, dict event):
        """Called by the runtime for every check."""
        self.total += 1
        dict stats = self.by_name.setdefault(
            event["name"],
            {"checks": 0, "failures": 0},
        )
        stats["checks"] += 1

        str verdict = "ok  "

        if event["ok"]:
            self.passed += 1
        else:
            self.failed += 1
            stats["failures"] += 1
            verdict = "FAIL"

        self._line(
            f"  {verdict}  {event['name']:<22} kind={event['kind']:<8}"
            f" expected={_name_of(event['expected']):<12} got={event['actual'].__name__}"
        )

    void finish(EnforcementMonitor self):
        """Print the summary (registered to run when the interpreter exits)."""
        self._line("=== enforcement summary ===")
        self._line(f"  checks performed : {self.total}")
        self._line(f"  passed           : {self.passed}")
        self._line(f"  failed           : {self.failed}")
        self._line(f"  elapsed          : {time.time() - self.started:.4f}s")

        list failing = sorted(
            (
                (name, s)
                for name, s in self.by_name.items()
                if s["failures"]
            ),
            key=lambda item: -item[1]["failures"],
        )

        if failing:
            self._line("  names with failures:")

            for name, stats in failing:
                self._line(
                    f"    {name}: {stats['failures']} of {stats['checks']} check(s) failed"
                )