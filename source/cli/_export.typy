"""``typy export``."""

from .. import tools
from ..archive import ARCHIVE_SUFFIX, collect_export_files, write_archive
from ..errors import TypyArchiveError, TypyNotAllowedToOverride, TypyProjectError
from ..logger import logger


int cmd_export(tools.args.Namespace args):
    """Package a project folder as a ``.typyexp`` archive.

    The archive is written under a temporary name and renamed into place, so
    an interrupted export never leaves a half-written file behind.
    """

    # Resolve and validate the project directory.
    tools.path.Path root = tools.path.Path(args.target).resolve()

    if not root.is_dir():
        raise TypyProjectError(f"'{root}' is not a project directory")

    # Resolve the requested output path, or use the default archive name.
    tools.path.Path destination = (
        tools.path.Path(args.output).resolve()
        if args.output
        else root.parent / f"{root.name}{ARCHIVE_SUFFIX}"
    )

    if destination.exists() and not args.override:
        raise TypyNotAllowedToOverride(destination)

    # Collect the project files and refuse to create an empty archive.
    list files = collect_export_files(root)

    if not files:
        raise TypyArchiveError(f"nothing to export: '{root}' has no files")

    # Write to a temporary path, then move the completed archive into place.
    tools.path.Path partial = destination.with_name(destination.name + ".partial")
    write_archive(root, files, partial)
    partial.replace(destination)

    # Record and report the completed export.
    logger.increment_stat("exports")
    logger.log(f"exported {root} -> {destination}")

    float size_kb = destination.stat().st_size / 1024
    print(f"exported {len(files)} file(s) ({size_kb:.1f} KB) -> {destination}")

    return 0