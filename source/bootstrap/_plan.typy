
"""Which Typy sources compile to which package modules."""

from .. import tools


# Hand-written files that deliberately have no Typy source.
tuple NOT_GENERATED = (
    "bootstrap/_stage0.py",
    "test.py",
)

# Top-level folders of the package that hold no compiler code.
tuple NOT_COMPILER = (
    "source",
    "tests",
    "example_project",
    "output",
    "docs",
    "assets",
    "stats",
)


list planned_outputs(tools.path.Path package_dir):
    """``[(source, target)]`` for every ``.typy`` file under
    ``package_dir/source``: each one compiles to the same relative path, as a
    ``.py`` file, inside the package itself."""

    tools.path.Path source_dir = package_dir / "source"
    list plan = []

    # Map each Typy source to its corresponding Python output path.
    for source in sorted(source_dir.rglob("*.typy")):
        plan.append(
            (
                source,
                package_dir / source.relative_to(source_dir).with_suffix(".py"),
            )
        )

    return plan


list orphaned_modules(tools.path.Path package_dir, list plan):
    """Compiler modules no source produces any more (the leftovers of a
    deleted ``.typy`` file), which would otherwise linger unnoticed."""

    set produced = {target for _, target in plan}
    list orphans = []

    # Find Python modules that are not generated by the current source plan.
    for path in sorted(package_dir.rglob("*.py")):
        tools.path.Path relative = path.relative_to(package_dir)

        unless (
            relative.parts[0] in NOT_COMPILER
            or "__pycache__" in relative.parts
        ):
            if (
                relative.as_posix() not in NOT_GENERATED
                and path not in produced
            ):
                orphans.append(relative.as_posix())

    return orphans
