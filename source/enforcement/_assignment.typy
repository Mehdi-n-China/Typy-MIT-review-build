"""Enforcing later assignments to typed names."""

from .. import tools
from ..semantics import BindingKind
from ._checked_value import checked_value
from ..context import CompileContext


tools.types.ModuleType _PYAST = tools.pyast


list enforce_assignment(dyn statement, CompileContext ctx):
    """``x = value`` where ``x`` was declared: check ``value`` against the
    declared type (or the type ``any`` established). Only single plain-name
    targets are enforced.
    """

    dyn binding = getattr(statement, "binding", None)

    if binding is not None:
        statement.value = checked_value(
            statement.value,
            binding,
            statement.targets[0].id,
            ctx,
        )

    return [statement]


list enforce_augmented(dyn statement, CompileContext ctx):
    """``x += value`` can change ``x``'s type (``int += float``), so the new
    value is re-checked in a statement that follows.
    """

    dyn binding = getattr(statement, "binding", None)

    if binding is None or binding.kind not in (
        BindingKind.CONCRETE,
        BindingKind.ANY,
    ):
        return [statement]  # dyn / untyped names are never enforced

    str name = statement.target.id

    _PYAST.Assign recheck = _PYAST.Assign(
        targets=[_PYAST.Name(id=name, ctx=_PYAST.Store())],
        value=checked_value(
            _PYAST.Name(id=name, ctx=_PYAST.Load()),
            binding,
            name,
            ctx,
        ),
    )

    return [statement, recheck]